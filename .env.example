# Общая инфраструктура (../docker-compose.yml): у Node-версии база analysis_node и Redis DB 2
DATABASE_URL=postgres://app:app@localhost:5432/analysis_node
REDIS_URL=redis://localhost:6379/2
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

YOUTUBE_API_KEY=
YOUTUBE_MAX_COMMENTS=200

# "провайдер:модель": deepseek:deepseek-chat, openai:gpt-4o-mini, anthropic:claude-sonnet-5-5
LLM_MODEL=deepseek:deepseek-chat
LLM_API_KEY=
LLM_BATCH_SIZE=50

TASK_TTL_SECONDS=86400

# Только в Node-версии (у всех есть значения по умолчанию)
# Сколько батчей LLM обрабатываются одновременно в рамках одной задачи
LLM_CONCURRENCY=4
# Сколько задач один процесс-воркер обрабатывает одновременно
WORKER_CONCURRENCY=2
PORT=8000
